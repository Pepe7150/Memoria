/*--------------------------------*- C++ -*----------------------------------*\
| createPatchDict                                                             |
| Corrige los tipos de patch después de gmshToFoam.                           |
|                                                                             |
| POR QUÉ ES NECESARIO: gmshToFoam importa TODOS los patches como tipo        |
| genérico "patch". Para un caso pseudo-2D, OpenFOAM necesita que las dos     |
| caras normales a z sean de tipo "empty" (así no resuelve en esa dirección), |
| y que la superficie del perfil sea de tipo "wall" (necesario para que los   |
| modelos de turbulencia apliquen bien las funciones de pared y para que      |
| forceCoeffs identifique la superficie sobre la cual integrar).              |
|                                                                             |
| USO:  copiar a system/ del caso y correr:  createPatch -overwrite           |
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Elimina puntos que queden sin usar tras la operación
pointSync false;

patches
(
    {
        name            airfoil;
        patchInfo
        {
            type        wall;
        }
        constructFrom patches;
        patches     (airfoil);
    }

    {
        name            farfield;
        patchInfo
        {
            type        patch;
        }
        constructFrom patches;
        patches     (farfield);
    }

    {
        name            outlet;
        patchInfo
        {
            type        patch;
        }
        constructFrom patches;
        patches     (outlet);
    }

    {
        name            front;
        patchInfo
        {
            type        empty;
        }
        constructFrom patches;
        patches     (front);
    }

    {
        name            back;
        patchInfo
        {
            type        empty;
        }
        constructFrom patches;
        patches     (back);
    }
);

// ************************************************************************* //
